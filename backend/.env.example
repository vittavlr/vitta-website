# MongoDB (use MongoDB Atlas free tier: https://www.mongodb.com/cloud/atlas/register)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vitta

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Owner account (seeded on first run if no owner exists)
SEED_OWNER_EMAIL=owner@vittagroup.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_OWNER_NAME=VITTA Owner

# SMTP (Gmail example) — use a Gmail "App Password", not your normal password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=VITTA

# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://vitta-group.github.io
